# UFDR React Frontend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Google OAuth Configuration (Required for login)
# =============================================================================
# Get this from Google Cloud Console: https://console.cloud.google.com/
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# =============================================================================
# API Configuration (Optional)
# =============================================================================
# Backend API URL - leave empty to use Create React App proxy (default)
# Set this if your backend is running on a different URL
# Example: http://localhost:8000 or https://api.yourapp.com
REACT_APP_API_URL=

# =============================================================================
# Notes
# =============================================================================
# - All environment variables must start with REACT_APP_ to be available in the app
# - Changes to .env require restarting the development server
# - Never commit the actual .env file to version control (it's in .gitignore)
